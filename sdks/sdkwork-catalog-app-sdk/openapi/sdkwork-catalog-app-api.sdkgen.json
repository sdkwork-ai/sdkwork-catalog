    "schemas": {
      "ProblemDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "code",
          "traceId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "integer",
            "format": "int32",
            "minimum": 40001,
            "maximum": 79999
          },
          "traceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "PageInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "page",
          "pageSize",
          "totalItems",
          "totalPages",
          "hasMore"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "const": "offset"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "totalItems": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "SdkWorkApiResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "data",
          "traceId"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "const": 0
          },
          "data": {},
          "traceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CatalogAttribute": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "attributeNo",
          "name",
          "valueType",
          "status",
          "sortOrder",
          "createdAt",
          "version",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "int64",
            "pattern": "^-?[0-9]+$",
            "x-sdkwork-int64-string": true,
            "x-sdkwork-rust-type": "i64",
            "description": "Primary key."
          },
          "attributeNo": {
            "type": "string",
            "description": "Stable business key of the attribute, unique per tenant while the row is live."
          },
          "name": {
            "type": "string",
            "description": "Default-locale name. Bounded by ck_commerce_product_attribute_name_length."
          },
          "valueType": {
            "type": "string",
            "enum": [
              "enum",
              "text",
              "number",
              "bool",
              "date"
            ],
            "description": "Declared value type. ck_commerce_product_attribute_value_type is the authority for this set."
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "description": "Shared lifecycle vocabulary. The authority for this set is the column CHECK constraint named in the field description."
          },
          "sortOrder": {
            "type": "string",
            "format": "int64",
            "pattern": "^-?[0-9]+$",
            "x-sdkwork-int64-string": true,
            "x-sdkwork-rust-type": "i64",
            "description": "Sibling ordering key, ascending."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Row creation time."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last write time."
          },
          "version": {
            "type": "string",
            "format": "int64",
            "pattern": "^-?[0-9]+$",
            "x-sdkwork-int64-string": true,
            "x-sdkwork-rust-type": "i64",
            "description": "Row version, advanced by every write to this row and by any write that rewrites the row's own storage identity (a category move also advances the moved subtree). It is the value an update or delete must send back as `If-Match`, and the same number the response's `ETag` carries, so a client that has read a resource can always name the version it read. `API_SPEC` section 17 keeps the version source, the required header, and the two result codes together: a missing `If-Match` answers `42801`, a stale one answers `41201`."
          }
        }
      },
      "CatalogCategory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "categoryNo",
          "path",
          "depth",
          "isLeaf",
          "name",
          "sortOrder",
          "status",
          "createdAt",
          "version",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "int64",
            "pattern": "^-?[0-9]+$",
            "x-sdkwork-int64-string": true,
            "x-sdkwork-rust-type": "i64",
            "description": "Primary key, minted by the service host before INSERT."
          },
          "categoryNo": {
            "type": "string",
            "description": "Stable business key of the category, unique per tenant while the row is live."
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "format": "int64",
            "pattern": "^-?[0-9]+$",
